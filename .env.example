# .env.example

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
APP_NAME=DeliveryApp
APP_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=delivery_db
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_POOL_SIZE=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRATION=3d

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback

# Maps
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
MAPBOX_STYLE_URL=

# Payment
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Notification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@deliveryapp.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# AWS (for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=delivery-app-uploads
AWS_CLOUDFRONT_DOMAIN=

# Admin
ADMIN_EMAIL=admin@deliveryapp.com
ADMIN_PASSWORD=Admin@123

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log

# Features
ENABLE_SCHEDULED_ORDERS=true
ENABLE_REALTIME_TRACKING=true
ENABLE_MULTI_LANGUAGE=true
DEFAULT_CURRENCY=USD
DEFAULT_LANGUAGE=en

# Search
SEARCH_MIN_SCORE=0.5
SEARCH_RESULTS_PER_PAGE=20

# Delivery
DEFAULT_DELIVERY_RADIUS=10 # km
DEFAULT_BASE_DELIVERY_FEE=2.99
DEFAULT_FREE_DELIVERY_THRESHOLD=30
DRIVER_ACCEPTANCE_TIMEOUT=30 # seconds

# Cache
CACHE_TTL=300 # seconds
CACHE_CHECK_PERIOD=60

# Queue
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_DB=1